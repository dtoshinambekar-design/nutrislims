# ==============================================================================
# Google Ads API Credentials Configuration
# Keep this file private and NEVER commit actual keys to public repositories.
# ==============================================================================

# 1. Developer Token (from Google Ads Manager Account > API Center)
GOOGLE_ADS_DEVELOPER_TOKEN=

# 2. OAuth2 Client ID & Secret (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# 3. OAuth2 Refresh Token (generated via generate_refresh_token.py)
GOOGLE_ADS_REFRESH_TOKEN=

# 4. Target Google Ads Customer ID (without hyphens)
GOOGLE_ADS_CUSTOMER_ID=7183123393

# 5. Manager Account ID (MCC) if your developer token belongs to a Manager Account (without hyphens)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
